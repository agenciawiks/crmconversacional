    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst mimeType = item.binary.data.mimeType;\nlet ext = 'bin';\nif (mimeType.includes('jpeg') || mimeType.includes('jpg')) ext = 'jpg';\nelse if (mimeType.includes('png')) ext = 'png';\nelse if (mimeType.includes('ogg')) ext = 'ogg';\nelse if (mimeType.includes('mpeg') || mimeType.includes('mp3')) ext = 'mp3';\nelse if (mimeType.includes('mp4')) ext = 'mp4';\nelse if (mimeType.includes('pdf')) ext = 'pdf';\nelse if (mimeType.includes('webp')) ext = 'webp';\n\nconst msgId = $('Parse Meta Payload').first().json.whatsapp_msg_id.replace(/[^a-zA-Z0-9_-]/g, '');\nconst objectKey = msgId + '_' + $('Parse Meta Payload').first().json.content_type + '.' + ext;\n\nitem.json.upload_file_name = objectKey;\nitem.json.upload_mime_type = mimeType;\n\nreturn [item];"
      },
