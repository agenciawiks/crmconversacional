    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst value = body.entry?.[0]?.changes?.[0]?.value || {};\nconst message = value.messages?.[0];\nconst contact = value.contacts?.[0];\nif (!message) return [{ json: { skip: true, reason: 'No message in payload' } }];\nconst type = message.type || 'text';\nconst media = message[type] || {};\nlet content = message.text?.body || media.caption || '';\nif (!content && ['image', 'audio', 'video', 'document'].includes(type)) {\n  content = type === 'image' ? '[Imagem]' : type === 'audio' ? '[Áudio]' : type === 'video' ? '[Vídeo]' : '[Documento]';\n}\nreturn [{ json: {\n  skip: false,\n  phone_number_id: String(value.metadata?.phone_number_id || ''),\n  whatsapp_msg_id: message.id,\n  phone: message.from,\n  contact_name: contact?.profile?.name || message.from,\n  direction: 'in',\n  content,\n  content_type: type,\n  media_id: media.id || null,\n  media_mime_type: media.mime_type || null,\n  timestamp: new Date(Number(message.timestamp) * 1000).toISOString(),\n  raw_payload: body\n} }];"
      },
